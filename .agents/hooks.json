{
  "redpen-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/redpen.js hook",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "session-capture": {
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/capture.js stop",
        "timeout": 30
      }
    ]
  }
}
